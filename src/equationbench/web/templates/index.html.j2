<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="EquationBench ranks language models on procedurally generated, exactly verifiable large-equation reasoning. No tools. Exact answers.">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="Can a model hold a thousand-term thought? Exact, procedurally generated math; one answer; no tools.">
  <meta property="og:type" content="website">
  <link rel="stylesheet" href="{{ root }}assets/style.css">
</head>
<body>
  <div class="bg-grid" aria-hidden="true"></div>
  <header class="site-header">
    <a class="brand" href="{{ root }}index.html" aria-label="EquationBench home">
      <span class="brand-mark">∑</span>
      <span class="brand-text">Equation<span>Bench</span></span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <a href="#ranking">Leaderboard</a>
      <a href="#tracks">Tracks</a>
      <a href="#method">Method</a>
      <a href="{{ root }}docs/methodology.html">Docs</a>
      <a class="nav-cta" href="#run-it">Run it</a>
    </nav>
    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation">☰</button>
  </header>

  <main>
    {% if benchmark.preview %}
    <div class="preview-banner">
      <span class="preview-tag">PREVIEW</span>
      {{ benchmark.n_models }} models · {{ benchmark.n_tasks_common }} of {{ benchmark.n_tasks }} tasks scored · provider-reported model IDs · not an official release
    </div>
    {% endif %}
    <div class="identity-note">
      <span>Model IDs are provider-reported by the serving provider.</span>
      {% if benchmark.track_filter %}
      <span>{% if benchmark.families|length == 1 %}{{ benchmark.families[0].label }} only{% else %}Selected tracks{% endif %} · {{ benchmark.n_tasks }} tasks{% if benchmark.n_tasks_available > benchmark.n_tasks %} (subset of {{ benchmark.n_tasks_available }}){% endif %}{% if benchmark.subset_note %} · {{ benchmark.subset_note }}{% endif %}</span>
      {% elif not benchmark.preview %}
      <span>Full {{ benchmark.n_tasks }}-task set · no wall-clock timeout.</span>
      {% endif %}
    </div>
    <section class="hero">
      <div class="hero-copy">
        <div class="eyebrow"><span class="pulse"></span> Benchmark v{{ benchmark.version }} · dataset {{ benchmark.dataset_version }} · {% if benchmark.preview %}{{ benchmark.n_tasks_common }} of {{ benchmark.n_tasks }} tasks{% else %}{{ benchmark.n_tasks }} tasks{% endif %}</div>
        {% if benchmark.track_filter %}
        <h1>Can a model solve a <span class="accent">large linear</span> system?</h1>
        <p class="lede">
          Linear Systems only. {{ benchmark.n_tasks }} tasks across {{ benchmark.levels|length }} levels,
          each an exact integer system with a unique solution. One prompt. One final answer.
          No tools, no partial credit, and no tolerance for a single wrong entry.
        </p>
        {% else %}
        <h1>Can a model hold a <span class="accent">thousand-term</span> thought?</h1>
        <p class="lede">
          EquationBench is a closed-book benchmark of procedurally generated equations that are
          large enough to defeat memorization and exact enough to grade with zero ambiguity.
          One prompt. One final answer. No tools, no code execution, no partial credit.
        </p>
        {% endif %}
        <div class="hero-actions">
          <a class="button primary" href="#ranking">View the ranking <span>↘</span></a>
          <a class="button ghost" href="{{ root }}docs/methodology.html">Read the methodology</a>
        </div>
        <div class="hero-stats">
          <div class="hero-stat"><strong>{{ benchmark.n_models }}</strong><span>models included</span></div>
          <div class="hero-stat"><strong>{{ benchmark.families|length }}</strong><span>task track{% if benchmark.families|length != 1 %}s{% endif %}</span></div>
          <div class="hero-stat"><strong>{{ benchmark.n_tasks_common }}</strong><span>tasks scored</span></div>
          <div class="hero-stat"><strong>0</strong><span>tolerance for wrong</span></div>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="orbit orbit-a"></div>
        <div class="orbit orbit-b"></div>
        {% if benchmark.track_filter %}
        <div class="equation-card">
          <div class="equation-label">EXACT LINEAR SYSTEM</div>
          <div class="equation-snippet">
            a₁₁x₁ + a₁₂x₂ + ⋯ + a₁ₙxₙ = b₁<br>
            ⋮<br>
            aₙ₁x₁ + aₙ₂x₂ + ⋯ + aₙₙxₙ = bₙ<br>
            n equations · n unknowns
          </div>
          <div class="equation-footer"><span class="dot"></span> unique exact integer solution</div>
        </div>
        <div class="equation-card small">
          <div class="equation-label">SOLUTION</div>
          <div class="equation-snippet">
            x = [2, −6, 0, −5, 6, −3, 6,<br>
            7, 4, −5, 9, 2, −9, −5, …]
          </div>
          <div class="equation-footer"><span class="dot cyan"></span> every entry exact</div>
        </div>
        <div class="equation-card tiny">
          <div class="equation-label">GRADING</div>
          <div class="equation-snippet">
            {"answer": [2, −6, 0, −5,<br>
            6, −3, 6, 7, 4, −5, 9, 2, −9, −5, …]}
          </div>
        </div>
        {% else %}
        <div class="equation-card">
          <div class="equation-label">L5 · ARITHMETIC</div>
          <div class="equation-snippet">
            ((((37,219 − 8) × (91,004 + 17))<sup>3</sup> − 12!) ×
            (6,113 × (2,997 − 41))) + 88,013
          </div>
          <div class="equation-footer"><span class="dot"></span> exact integer · 47 digits</div>
        </div>
        <div class="equation-card small">
          <div class="equation-label">L4 · RECURRENCE</div>
          <div class="equation-snippet">a<sub>n</sub> ≡ 3a<sub>n−1</sub> − 7a<sub>n−3</sub> (mod 998244353)</div>
          <div class="equation-footer"><span class="dot cyan"></span> n = 7,412,906,335,117</div>
        </div>
        <div class="equation-card tiny">
          <div class="equation-label">L3 · MODULAR</div>
          <div class="equation-snippet">7<sup>(9<sup>(11<sup>5</sup>)</sup>)</sup> mod 1,000,003</div>
        </div>
        {% endif %}
      </div>
    </section>

    <section id="ranking" class="section panel">
      <div class="section-head">
        <div>
          <div class="kicker">01 / Ranking</div>
          <h2>The EquationBench Leaderboard</h2>
          <p class="section-sub">EQB Score is difficulty-weighted exact pass@1. Intervals are paired cell-cluster bootstrap 95% CIs over tasks.{% if benchmark.preview %} Preview build: {{ benchmark.n_tasks_common }} of {{ benchmark.n_tasks }} tasks.{% endif %}</p>
        </div>
        <div class="controls">
          <label class="control">
            <span>Division</span>
            <select id="division-filter"></select>
          </label>
          <label class="control">
            <span>Lab</span>
            <select id="lab-filter"></select>
          </label>
          <label class="control">
            <span>Sort</span>
            <select id="sort-select">
              <option value="rank">Official rank</option>
              <option value="score">EQB Score</option>
              <option value="cost">Cost efficiency</option>
              <option value="latency">Latency</option>
              <option value="name">Name</option>
            </select>
          </label>
          <label class="control search-control">
            <span>Search</span>
            <input id="search-input" type="search" placeholder="model or lab…" autocomplete="off">
          </label>
        </div>
      </div>

      <div class="table-meta">
        <span id="model-count">{{ benchmark.n_models }} models</span>
        <span class="table-hint">Hover a {% if benchmark.track_filter %}level{% else %}track{% endif %} bar for its score. Click a model for its full breakdown and sample answers.</span>
      </div>
      <div class="table-wrap">
        <table class="leaderboard" id="leaderboard-table">
          <caption class="sr-only">EquationBench model ranking</caption>
          <thead>
            <tr>
              <th scope="col" class="col-rank">#</th>
              <th scope="col">Model</th>
              <th scope="col" class="col-score">EQB Score</th>
              <th scope="col" class="col-acc">Accuracy</th>
              <th scope="col" class="col-tracks">{% if benchmark.track_filter %}Level profile{% else %}Track profile{% endif %}</th>
              <th scope="col" class="col-cost">Cost / 100</th>
              <th scope="col" class="col-latency">Latency</th>
              <th scope="col" class="col-link"></th>
            </tr>
          </thead>
          <tbody id="leaderboard-body"></tbody>
        </table>
      </div>
      <div class="table-foot">
        <span class="legend-item"><span class="legend-bar lime"></span> 75–100</span>
        <span class="legend-item"><span class="legend-bar gold"></span> 50–74</span>
        <span class="legend-item"><span class="legend-bar rose"></span> 0–49</span>
        <span class="legend-item muted">Timeouts and provider errors count as incorrect.</span>
        <span class="legend-item muted">Cost is provider-reported for the evaluated tasks.</span>
      </div>
    </section>

    <section class="section grid-2">
      <div class="panel chart-panel">
        <div class="section-head compact">
          <div>
            <div class="kicker">02 / Efficiency</div>
            <h2>Score vs. cost</h2>
          </div>
          <span class="pill">evaluated tasks · USD</span>
        </div>
        <div id="cost-chart" class="chart" role="img" aria-label="Scatter plot of EquationBench score versus cost per 100 tasks"></div>
        <p class="fineprint">Costs are reported by the serving provider. Models with unavailable cost data are omitted from this chart, not from the ranking.</p>
      </div>
      <div class="panel score-explainer">
        <div class="kicker">03 / The metric</div>
        <h2>Why a weighted score?</h2>
        <p>A raw average lets easy arithmetic hide failures on frontier tasks. EquationBench weights every correct answer by its difficulty weight, then normalizes by the available weight:</p>
        <div class="formula">EQB Score = 100 · Σ (level · correct) / Σ level</div>
        <div class="metric-list">
          <div><strong>Exact</strong><span>Integer, rational, or integer vector after canonicalization. No tolerance.</span></div>
          <div><strong>Closed-book</strong><span>Tools and code execution are disabled for every model.</span></div>
          <div><strong>Paired</strong><span>All models answer the same fixed task set; CIs resample tasks, not prompts.</span></div>
        </div>
      </div>
    </section>

    <section id="tracks" class="section panel">
      <div class="section-head">
        <div>
          <div class="kicker">04 / Tracks</div>
          {% if benchmark.track_filter %}
          <h2>The {{ benchmark.families[0].label }} track</h2>
          <p class="section-sub">Linear-systems-only profile: {{ benchmark.n_tasks }} tasks across {{ benchmark.levels|length }} levels{% if benchmark.n_tasks_available > benchmark.n_tasks %}, extracted from the {{ benchmark.n_tasks_available }}-task public set{% else %}, dedicated linear-only set{% endif %}.</p>
          {% else %}
          <h2>Seven ways to get lost in an equation</h2>
          <p class="section-sub">Each track has five difficulty levels. The generator is public; the official evaluation seed is not.</p>
          {% endif %}
        </div>
        <span class="pill">{% if benchmark.preview %}{{ benchmark.n_tasks_common }} scored / {{ benchmark.n_tasks }} total{% elif benchmark.track_filter %}{{ benchmark.n_tasks }} tasks · {{ benchmark.families|length }} track{% else %}{{ benchmark.n_tasks }} tasks{% endif %}</span>
      </div>
      <div id="track-grid" class="track-grid"></div>
    </section>

    <section id="method" class="section grid-2">
      <div class="panel">
        <div class="kicker">05 / Protocol</div>
        <h2>Built to be cited, not gamed.</h2>
        <p class="section-sub">EquationBench is deterministic from a master seed, exactly verifiable, and versioned end to end.</p>
        <div class="protocol-grid">
          <div class="protocol-item"><span class="protocol-num">01</span><strong>Procedural</strong><p>Every task is generated by a program from a seed. The public set is reproducible; the sealed holdout is encrypted.</p></div>
          <div class="protocol-item"><span class="protocol-num">02</span><strong>Exact</strong><p>Ground truth is computed with integer and rational arithmetic. There are no LLM judges and no tolerance bands.</p></div>
          <div class="protocol-item"><span class="protocol-num">03</span><strong>Auditable</strong><p>Runs store prompts, responses, token usage, cost, latency, and the dataset hash. Every leaderboard row links to one.</p></div>
          <div class="protocol-item"><span class="protocol-num">04</span><strong>Uncertainty-aware</strong><p>Reported intervals are paired cell-cluster bootstrap estimates over the benchmark tasks.</p></div>
        </div>
        <a class="text-link" href="{{ root }}docs/methodology.html">Read the full methodology →</a>
      </div>
      <div class="panel callout">
        <div class="kicker">06 / Contamination</div>
        <h2>The test set is public. The holdout is not.</h2>
        <p>The open leaderboard uses a fixed public test set so anyone can reproduce a result. A separate sealed holdout—encrypted at rest, with a published hash commitment—is used to validate top entries and future seasons.</p>
        <div class="hash-box">
          <span>dataset commitment</span>
          <code>{{ benchmark.dataset_sha256[:32] }}…</code>
        </div>
        <div class="mini-stats">
          <div><strong>{{ benchmark.task_stats.prompt_chars.median }}</strong><span>median prompt chars</span></div>
          <div><strong>{{ benchmark.task_stats.answer_digits.median }}</strong><span>median answer digits</span></div>
          <div><strong>{{ benchmark.bootstrap_replicates }}</strong><span>bootstrap resamples</span></div>
        </div>
        <a class="text-link" href="{{ root }}docs/methodology.html#datasets-and-contamination">How the holdout works →</a>
      </div>
    </section>

    <section id="run-it" class="section panel cta">
      <div class="cta-copy">
        <div class="kicker">07 / Reproduce</div>
        <h2>Run your model. Publish the receipt.</h2>
        <p>Install the harness, point it at an OpenAI-compatible endpoint or a pi-supported provider, and run the same fixed task set. Runs are resumable and store everything needed to audit the score.</p>
        <div class="code-row">
          <code id="quickstart-code">eqb run --model deepseek-v4-1-flash --dataset datasets/equationbench-v1-test</code>
          <button class="copy-button" data-copy="#quickstart-code">Copy</button>
        </div>
        <div class="cta-links">
          <a class="button primary" href="{{ root }}docs/submission.html">Submission guide</a>
          <a class="button ghost" href="{{ root }}data/leaderboard.json" download>Download leaderboard JSON</a>
        </div>
      </div>
      <div class="cta-badge" aria-hidden="true">
        <span class="cta-badge-inner">EQB<br><em>v{{ benchmark.version }}</em></span>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-brand"><span class="brand-mark small">∑</span> EquationBench</div>
    <div class="footer-meta">
      <span>{{ benchmark.generated_at[:10] }} · dataset {{ benchmark.dataset_version }} · {{ benchmark.n_models }} models</span>
      <a href="{{ root }}docs/methodology.html">Methodology</a>
      <a href="{{ root }}docs/submission.html">Submit</a>
      <a href="{{ root }}data/leaderboard.json">Data</a>
    </div>
    <div class="footer-note">Exact answers. No judges. No excuses.</div>
  </footer>

  <script>window.EQB_DATA = {{ data_json | safe }};</script>
  <script src="{{ root }}assets/app.js"></script>
</body>
</html>
